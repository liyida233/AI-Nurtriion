@startuml
title Sequence Diagram: User Login and Session Authentication

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12
skinparam maxMessageSize 90
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
}

actor User
participant "Web Dashboard" as Frontend
participant "Auth Controller\n(Backend API)" as Auth
participant "Auth Service" as AuthService
database "MySQL Database" as DB
collections "Redis Session Cache" as Redis

User -> Frontend: Enter email and password
Frontend -> Auth: POST /api/auth/login
Auth -> AuthService: Validate login request
AuthService -> DB: Find user by email
DB --> AuthService: User record + password hash

alt Valid credentials
  AuthService -> AuthService: Verify password hash
  AuthService -> AuthService: Generate JWT / session token
  AuthService -> Redis: Store session / token metadata
  Redis --> AuthService: Session stored
  AuthService --> Auth: Login success + token
  Auth --> Frontend: 200 OK + token + user profile summary
  Frontend --> User: Redirect to dashboard
else Invalid credentials
  AuthService --> Auth: Authentication failed
  Auth --> Frontend: 401 Unauthorized
  Frontend --> User: Show login error
end

@enduml
