@startuml
title Sequence Diagram: Goal Creation and Milestone Management

skinparam backgroundColor white
skinparam shadowing false
skinparam maxMessageSize 90

actor User
participant "React Web App" as Frontend
participant "Goal Controller" as Controller
participant "Goal Service" as Service
participant "Feasibility Analyzer" as Analyzer
database "MySQL" as DB
collections "Redis" as Redis

User -> Frontend: Enter target, deadline, priority,\nand up to three milestones
Frontend -> Controller: POST /api/goals
Controller -> Service: Create(userId, request)
Service -> Service: Parse deadline
Service -> Analyzer: Check type, metric,\ntarget and available time

alt Goal is infeasible
  Analyzer --> Service: Feasibility warning
  Service --> Controller: Validation error
  Controller --> Frontend: 422 Unprocessable Entity
  Frontend --> User: Display safer adjustment message
else Goal is feasible
  Analyzer --> Service: Accepted
  Service -> Service: Create goal UUID

  alt User supplied milestones
    Service -> Service: Validate and map custom milestones
  else No milestones supplied
    Service -> Service: Generate three proportional defaults
  end

  Service -> DB: Save goal and milestones
  DB --> Service: Saved records
  Service -> Redis: Invalidate weekly dashboard cache
  Service -> DB: Reload goal with milestones
  DB --> Service: Complete goal
  Service --> Controller: Goal result
  Controller --> Frontend: 201 Created
  Frontend --> User: Display goal and milestone progress
end

User -> Frontend: Toggle milestone completion
Frontend -> Controller: PATCH /api/goals/{goalId}/milestones/{id}
Controller -> Service: Verify ownership and update state
Service -> DB: Update milestone
Service -> Redis: Invalidate weekly dashboard cache
Service --> Controller: Updated milestone
Controller --> Frontend: 200 OK
@enduml
