@startuml
left to right direction
title Use Case Diagram: AI-Enhanced Fitness and Nutrition Tracking System

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #344054
  ArrowColor #344054
}

actor "General User" as User
actor Administrator as Admin
actor "Configured AI Provider\n(Mock or External)" as AI

rectangle "AI-Enhanced Fitness and Nutrition Tracking System" {
  package "Account and Tracking" {
    usecase "Register and Login" as UC1
    usecase "Manage Profile" as UC2
    usecase "Manage Workout Journal" as UC3
    usecase "Manage Nutrition Journal" as UC4
    usecase "Manage Body Records" as UC5
    usecase "Manage Goals and Milestones" as UC6
  }

  package "Decision Support" {
    usecase "View Date-Range Dashboard" as UC7
    usecase "Generate Recommendation" as UC8
    usecase "Submit Recommendation Feedback" as UC9
    usecase "Generate and Download\nProgress Report" as UC10
    usecase "Analyse User Data" as UC11
    usecase "Generate Provider Output" as UC12
  }

  package "Administration" {
    usecase "Manage Users and Roles" as UC13
    usecase "Manage Exercise References" as UC14
    usecase "Manage Food References" as UC15
  }
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

UC7 .> UC11 : <<include>>
UC8 .> UC11 : <<include>>
UC8 .> UC12 : <<include>>
UC10 .> UC11 : <<include>>

AI --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

note bottom of Admin
  Administrators may also use
  general-user functions.
end note
@enduml
