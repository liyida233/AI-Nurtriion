@startuml
title Activity Diagram: Dashboard Analytics Workflow

skinparam backgroundColor white
skinparam shadowing false

start
:User selects daily, weekly,\nmonthly, or custom period;
:Frontend requests /api/dashboard/summary;
:Backend validates and resolves date range;

if (Weekly request and valid cache exists?) then (Yes)
  :Read DashboardSummary from Redis;
else (No)
  :Retrieve user profile, workouts, meals,\nbody records, goals, and milestones;
  :Calculate workout consistency,\nvolume, progressive load,\nand muscle-group distribution;
  :Calculate calories, macro grams,\nmacro ratios, nutrition gaps,\nand meal-quality score;
  :Calculate BMR, estimated TDEE,\ncalorie balance, weight trend,\nand seven-day average;
  :Calculate active goals,\nmilestones, and goal adherence;

  if (Persist requested?) then (Yes)
    :Save selected summary fields\nas AnalyticsSnapshot;
  endif

  if (Period is weekly?) then (Yes)
    :Cache summary in Redis for five minutes;
  endif
endif

:Return DashboardSummary JSON;
:Render cards, distributions,\nwarnings, and selected-period values;
stop
@enduml
