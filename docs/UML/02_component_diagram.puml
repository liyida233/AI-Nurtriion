@startuml
top to bottom direction
title Component Diagram: System Architecture

skinparam backgroundColor white
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Client Layer" {
  [React and TypeScript\nWeb Application] as Frontend
}

package "Go REST API" {
  [Gin Router, CORS,\nJWT and Role Middleware] as Gateway

  package "Domain Modules" {
    [Authentication\nand Profile] as Auth
    [Workout] as Workout
    [Nutrition] as Nutrition
    [Body] as Body
    [Goal] as Goal
    [Administration] as Admin
  }

  [Analytics Service] as Analytics
  [Recommendation Service] as Recommendation
  [Report Service] as Report
  [GORM Repositories] as Repositories
  [Redis Session, Cache,\nand Rate-Limit Support] as Cache
}

package "Persistence and Infrastructure" {
  database "MySQL 8.4" as MySQL
  collections "Redis 7.4" as Redis
  folder "Generated HTML Reports" as Files
}

package "Recommendation Provider" {
  [Mock Provider\n(Default)] as Mock
  [OpenAI-Compatible Provider\n(Optional)] as External
}

Frontend --> Gateway : REST/JSON
Gateway --> Auth
Gateway --> Workout
Gateway --> Nutrition
Gateway --> Body
Gateway --> Goal
Gateway --> Admin
Gateway --> Analytics
Gateway --> Recommendation
Gateway --> Report

Auth --> Repositories
Workout --> Repositories
Nutrition --> Repositories
Body --> Repositories
Goal --> Repositories
Admin --> Repositories
Analytics --> Repositories
Recommendation --> Repositories
Report --> Repositories
Repositories --> MySQL

Auth --> Cache : session state
Workout --> Cache : invalidate summary
Nutrition --> Cache : invalidate summary
Body --> Cache : invalidate summary
Goal --> Cache : invalidate summary
Analytics --> Cache : weekly cache
Recommendation --> Cache : rate limit
Cache --> Redis

Recommendation --> Analytics : weekly indicators
Recommendation --> Mock : default
Recommendation ..> External : configurable
Report --> Analytics : requested-period indicators
Report --> Files : write/download HTML
@enduml
