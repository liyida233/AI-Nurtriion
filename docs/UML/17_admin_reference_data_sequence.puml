@startuml
title Sequence Diagram: Admin Management of Food and Exercise Databases

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12
skinparam maxMessageSize 90
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
}

actor Admin
participant "Admin Dashboard" as Frontend
participant "Admin Controller\n(Backend API)" as AdminAPI
participant "Access Control Middleware" as ACL
participant "Reference Data Service" as RefService
database "MySQL Database" as DB
collections "Redis Cache" as Redis

Admin -> Frontend: Add / update food or exercise item
Frontend -> AdminAPI: POST /api/admin/reference-data
AdminAPI -> ACL: Verify admin role
ACL -> DB: Retrieve user role
DB --> ACL: Role metadata

alt Admin role verified
  ACL --> AdminAPI: Access granted
  AdminAPI -> RefService: Validate reference data
  RefService -> DB: Insert or update food_item / exercise
  DB --> RefService: Save success
  RefService -> Redis: Invalidate reference data cache
  RefService --> AdminAPI: Updated item response
  AdminAPI --> Frontend: 200 OK
  Frontend --> Admin: Show updated database item
else Access denied
  ACL --> AdminAPI: Access denied
  AdminAPI --> Frontend: 403 Forbidden
  Frontend --> Admin: Show permission error
end

@enduml
