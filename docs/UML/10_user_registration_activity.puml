@startuml
title Activity Diagram: User Registration and Profile Setup

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12

start
:User opens registration page;
:Enter account details\n(name, email, password);

if (Input valid?) then (Yes)
  :Check whether email already exists;
  if (Email available?) then (Yes)
    :Hash password;
    :Create user account;
    :Create default user role;
    :Redirect to health profile setup;
    :User enters age, gender,\nheight, weight, activity level,\nand primary fitness goal;
    if (Profile data complete?) then (Yes)
      :Save health profile;
      :Enable analytics modules;
      :Redirect to dashboard;
    else (No)
      :Show missing profile fields;
    endif
  else (No)
    :Show email already registered error;
  endif
else (No)
  :Show validation error;
endif

stop
@enduml
